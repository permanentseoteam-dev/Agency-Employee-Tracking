{
  "name": "pseo-tracker",
  "productName": "PSEO Tracker",
  "version": "0.1.6",
  "description": "Employee activity, attendance, leave and payroll tracker for the agency",
  "author": "Permanent SEO",
  "main": "out/main/index.js",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "check:rules": "node scripts/check-rules-supabase.mjs",
    "test:env": "node scripts/test-env/index.mjs",
    "test:app": "node scripts/test-env/app.mjs",
    "test:e2e": "node scripts/e2e/run.mjs",
    "test:all": "npm run typecheck && npm test && npm run check:rules && npm run test:e2e",
    "icon": "electron scripts/make-icon.mjs",
    "dist": "node scripts/check-release-env.mjs && electron-vite build --mode production --outDir out-release && electron-builder --win --publish never",
    "release": "node scripts/check-release-env.mjs && electron-vite build --mode production --outDir out-release && electron-builder --win --publish always"
  },
  "dependencies": {
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@supabase/supabase-js": "^2.117.3",
    "@tanstack/react-query": "^5.104.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "electron-log": "^5.4.4",
    "electron-store": "^12.0.0",
    "electron-updater": "^6.8.9",
    "lucide-react": "^1.56.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tailwind-merge": "^3.7.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^44.7.2",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "pocketbase": "^0.28.1",
    "postgres": "^3.4.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^7.3.7",
    "vitest": "^5.0.4"
  }
}
