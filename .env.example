# Development build (npm run dev): the STAGING Supabase project, never live.
# Copy to .env and fill in from .env.supabase (STAGING_URL, STAGING_ANON_KEY). The anon key is public.
# Release builds read .env.production instead (see .env.production.example and docs/deployment.md).
VITE_SUPABASE_URL=https://<staging-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<staging anon key>
